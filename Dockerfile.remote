FROM osrf/ros:humble-desktop-full

ENV DEBIAN_FRONTEND=noninteractive

# 1. Install Remote PC Navigation, SLAM, and rosbridge
RUN apt-get update && apt-get install -y \
    ros-humble-rmw-cyclonedds-cpp \
    ros-humble-turtlebot3 \
    ros-humble-turtlebot3-msgs \
    ros-humble-navigation2 \
    ros-humble-nav2-bringup \
    ros-humble-slam-toolbox \
    ros-humble-rviz2 \
    ros-humble-rosbridge-suite \
    python3-colcon-common-extensions \
    git \
    tmux \
    nano \
    ruby \
    ruby-dev \
    build-essential \
    wget \
    "~nros-humble-rqt*" \
    && rm -rf /var/lib/apt/lists/*

# 2. Match Robot Environment Variables EXACTLY
ENV ROS_DOMAIN_ID=184
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV TURTLEBOT3_MODEL=burger
ENV CYCLONEDDS_URI=file:///root/turtlebot3_ws/src/cyclonedds.xml

# 3. Source ROS 2 automatically
RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc
RUN echo 'source ~/turtlebot3_ws/install/setup.bash' >> ~/.bashrc

# 4. Directory setup
RUN mkdir -p ~/turtlebot3_ws/src
WORKDIR /root/turtlebot3_ws

# 5. Entrypoint: start rosbridge by default, but allows dropping into bash
COPY agenticros/docker/ros2_entrypoint.sh /ros2_entrypoint.sh
RUN chmod +x /ros2_entrypoint.sh

ENTRYPOINT ["/ros2_entrypoint.sh"]
CMD ["ros2", "launch", "rosbridge_server", "rosbridge_websocket_launch.xml"]
